# ============================================================
# Production Environment Variables
# ============================================================
# Este archivo se sincroniza automáticamente con el VPS vía git.
# Cambios aquí se aplican en el próximo deploy (~5 min).

# Admin emails que se promuervan automáticamente a rol "admin" al primer login
# Si un usuario está en esta lista, al logearse se le crea el perfil con rol admin
ADMIN_EMAILS=benjamincousino1@gmail.com

# Logo.dev key para mostrar logos de instituciones en el carrusel
NEXT_PUBLIC_LOGO_DEV_KEY=pk_fxtQX2tuQi6nhbAQY3jUKQ

# Evomi expert setting: filtra IPs con puntuación de fraude Scamalytics ≤20
# (más limpias) para reducir el bloqueo duro (t=bv) de DataDome en Idealista.
# ⚠️ Aumenta el consumo de ancho de banda de Evomi. Prueba: si el t=bv no baja
# de forma clara en unos días (medir con /api/admin/particulares/proxy-health),
# quitar esta línea. Lo lee lib/sync/proxy-config.ts (buildEvomiUrl).
EVOMI_FRAUDSCORE=20

# Proxy residencial Evomi — PROVEEDOR PRINCIPAL (docs.evomi.com).
# Fallback usado por lib/sync/proxy-config.ts SOLO si app_settings
# ["scraping.proxyUrl"] (fuente de verdad, editable en /admin/configuracion)
# está vacío o la BD no responde. Se acepta tal cual la copia el panel de
# Evomi (host:puerto:usuario:password); el código limpia y ancla
# sesión/país/lifetime en cada request (ver buildEvomiUrl).
PROXY_URL=core-residential.evomi.com:1000:portales3:Um72i6DQURDoxb1Ez1xs_country-ES

# País por defecto para las sesiones sticky de Evomi cuando la llamada no fija
# uno explícito (el flujo de teléfono SÍ rota países en reintentos vía
# COUNTRY_ROTATION y este valor no le afecta). Idealista es solo España.
PROXY_COUNTRY=ES
