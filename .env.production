# ============================================================
# Production Environment Variables
# ============================================================
# Este archivo se sincroniza automáticamente con el VPS vía git.
# Cambios aquí se aplican en el próximo deploy (~5 min).

# Admin emails que se promuervan automáticamente a rol "admin" al primer login
# Si un usuario está en esta lista, al logearse se le crea el perfil con rol admin
ADMIN_EMAILS=benjamincousino1@gmail.com

# CapSolver API key para resolver CAPTCHAs de DataDome (Idealista)
CAPSOLVER_API_KEY=CAP-B74697ACB56A79B524F069613CCEB4031A545B154DE26C79CEA813F62678441B

# Logo.dev key para mostrar logos de instituciones en el carrusel
NEXT_PUBLIC_LOGO_DEV_KEY=pk_fxtQX2tuQi6nhbAQY3jUKQ

# Relay (relay.167.233.48.91.sslip.io) — servicio propio de scraping por API,
# usado por "Importar propiedad por link" (lib/sync/relay-api.ts) ANTES de
# caer al proxy legacy de abajo. 2026-09-14: confirmado contra su
# documentación pública (.../docs/) que es una API REST
# (`POST https://cp.167.233.48.91.sslip.io/scrape` + header `x-api-key`), NO
# un proxy HTTP clásico — el host "relay." (sin la "cp.") SÍ responde a un
# CONNECT (probado con curl -x, da 403 proxy_ip_not_allowed para IPs no
# autorizadas) pero esa es una superficie interna, no la vía documentada:
# no la uses como PROXY_URL.
#
# Fallback SOLO si app_settings["scraping.relayApiKey"] (fuente de verdad,
# editable en /admin/configuracion → Scraping → "Relay API Key") está vacío
# o la BD no responde. Sin la key (ni aquí ni en el panel), fetch-html.ts
# salta este intento y sigue con proxy/Playwright/Wayback como antes.
# RELAY_API_KEY=rk-...

# ⚠️ EVOMI_FRAUDSCORE: "expert setting" propio del formato de password de
# Evomi (ver buildEvomiUrl en lib/sync/proxy-config.ts). Sigue aplicando SOLO
# si PROXY_URL/app_settings["scraping.proxyUrl"] apunta a Evomi — hoy sigue
# siendo el proveedor activo en el panel (Evomi está bloqueado por DataDome
# en Idealista, ver CLAUDE.md; Relay de arriba es la vía nueva, este proxy
# queda como último fallback si Relay también falla o no tiene key).
EVOMI_FRAUDSCORE=20

# Proxy residencial de RESPALDO (Evomi) — usado por import-by-link/particulares
# SOLO si Relay (arriba) falla o no tiene key configurada, vía
# lib/sync/proxy-config.ts. Fallback SOLO si app_settings["scraping.proxyUrl"]
# (fuente de verdad, editable en /admin/configuracion) está vacío o la BD no
# responde — y la BD hoy SÍ tiene un valor (Evomi, activo en el panel), así
# que esta línea no tiene efecto en producción mientras eso no cambie.
PROXY_URL=core-residential.evomi.com:1000:portales3:Um72i6DQURDoxb1Ez1xs_country-ES

# País por defecto para las sesiones sticky de Evomi cuando la llamada no fija
# uno explícito (el flujo de teléfono SÍ rota países en reintentos vía
# COUNTRY_ROTATION y este valor no le afecta). Idealista es solo España.
PROXY_COUNTRY=ES
