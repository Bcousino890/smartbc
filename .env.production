# ============================================================
# Production Environment Variables
# ============================================================
# Este archivo se sincroniza automáticamente con el VPS vía git.
# Cambios aquí se aplican en el próximo deploy (~5 min).

# Admin emails que se promuervan automáticamente a rol "admin" al primer login
# Si un usuario está en esta lista, al logearse se le crea el perfil con rol admin
ADMIN_EMAILS=benjamincousino1@gmail.com

# CapSolver API key para resolver CAPTCHAs de DataDome (Idealista)
CAPSOLVER_API_KEY=CAP-B74697ACB56A79B524F069613CCEB4031A545B154DE26C79CEA813F62678441B

# Logo.dev key para mostrar logos de instituciones en el carrusel
NEXT_PUBLIC_LOGO_DEV_KEY=pk_fxtQX2tuQi6nhbAQY3jUKQ

# ⚠️ EVOMI_FRAUDSCORE queda desactivado: es un "expert setting" propio del
# formato de password de Evomi (ver buildEvomiUrl en lib/sync/proxy-config.ts)
# y con el relay propio de abajo (sin usuario/password en la URL) no hace
# nada — pero si el relay algún día lleva auth en la URL, este modificador se
# le pegaría igual al password y rompería su autenticación real. Se deja
# comentado en vez de borrado por si se vuelve a Evomi más adelante.
# EVOMI_FRAUDSCORE=20

# Proxy/relay para scraping (Idealista/Fotocasa) — usado por import-by-link
# (extraer propiedad por link) Y por el scraper de particulares, los DOS vía
# lib/sync/proxy-config.ts (mismo helper, mismo valor). Fallback SOLO si
# app_settings["scraping.proxyUrl"] (fuente de verdad, editable en
# /admin/configuracion) está vacío o la BD no responde.
#
# 2026-09-14: se migró de Evomi (bloqueado por DataDome) al relay propio en
# el VPS de particulares. Sin usuario/password en la URL: el código lo
# detecta como proveedor "generic" y lo usa tal cual, sin intentar anclarle
# modificadores de sesión/país (esos solo se aplican si la URL trae auth).
PROXY_URL=https://relay.167.233.48.91.sslip.io/app/

# Ya no aplica con el relay actual (sin auth en la URL, ver arriba): solo
# tenía efecto para las sesiones sticky con modificadores en el password de
# Evomi/Smartproxy/Geonode. Se deja comentado por si se vuelve a un proveedor
# de ese tipo.
# PROXY_COUNTRY=ES
