      "title": "house type",
      "description": "Type availability varies between countries. Italy: villa. Portugal: andar_moradia. France: villa, semidetached, independent, terraced. The rest of the types are available in each country.",
      "enum": [
        "andar_moradia",
        "independent",
        "semidetached",
        "terraced",
        "villa"
      ]
    },
    "areaConstructed": {
      "$ref": "features.json#/housingAreaConstructed"
