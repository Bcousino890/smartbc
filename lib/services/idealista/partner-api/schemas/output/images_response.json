{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "http://localhost:8080/api-reference/jsonschemas/output/images_response.json",
  "title": "Property image",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url"
  ],
  "properties": {
    "message":{
      "type":"string",
      "default": "Successful Operation",
      "required":true,
      "description":"The message content for the response"
    },
    "success":{
      "type":"boolean",
      "default": true,
      "required":true,
      "description":"Indicates whether or not the request was successful"
    },
    "images": {
      "$ref": "image_array.json"
    }
  }
}
