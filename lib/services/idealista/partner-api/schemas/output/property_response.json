{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "http://localhost:8080/api-reference/jsonschemas/output/property_response.json",
  "title": "Property Update or Created Response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "message":{
      "type":"string",
      "description":"The message content for the response"
    },
    "success":{
      "type":"boolean",
      "description":"Indicates whether or not the request was successful"
    },
    "propertyCode": {
      "title": "Property identifier",
      "$ref": "../rules.json#/stringTo50"
    },
    "propertyId": {
      "title": "idealista Property identifier",
      "$ref": "../rules.json#/propertyId"
    },
    "state": {
      "default": "active",
      "title": "Property state",
      "$ref": "../rules.json#/enumPropertyStatus"
    },
    "scope": {
      "title": "Property visibility",
      "$ref": "../rules.json#/enumPropertyVisibility"
    },
    "publishInfo": {
      "title": "Publish Info",
      "$ref": "../property/publishInfo.json"
    }
  }
}
