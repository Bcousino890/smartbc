    "message",
    "success"
  ],
  "properties": {
    "message": {
      "type": "string",
      "default": "Client has not an active account",
      "required": true,
      "description": "The message content for the response"
    },
    "success": {
      "type": "boolean",
      "default": false,
      "required": true,
      "description": "Indicates that the account is not active"
    }
  }
}