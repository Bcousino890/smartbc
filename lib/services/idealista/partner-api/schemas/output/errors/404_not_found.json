{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "http://localhost:8080/api-reference/jsonschemas/output/errors/404_not_found.json",
  "title": "Resource Not found",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "propertyId",
    "state"
  ],
  "properties": {
    "message":{
      "type":"string",
      "default": "Not Found",
      "required":true,
      "description":"The message content for the response"
    },
    "success":{
      "type":"boolean",
      "default": false,
      "required":true,
      "description":"Indicates whether or not the request was successful"
    }
  }
}
