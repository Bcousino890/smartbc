{
  "manifest_version": 3,
  "name": "SmartBC",
  "short_name": "SmartBC",
  "version": "2.0.0",
  "description": "Marca anuncios en Idealista, Fotocasa, Habitaclia y pisos.com y mándalos a la ficha de un cliente de SmartBC. Requiere un usuario de SmartBC.",
  "author": "Benjamín Cousiño Propiedades",
  "homepage_url": "https://portal.bcousinoprop.com",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.idealista.com/*",
    "https://www.fotocasa.es/*",
    "https://www.habitaclia.com/*",
    "https://www.pisos.com/*",
    "https://portal.bcousinoprop.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SmartBC",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.idealista.com/tools/propiedad/nuevo*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.idealista.com/inbox*"],
      "js": ["inbox-leads.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.idealista.com/*",
        "https://www.fotocasa.es/*",
        "https://www.habitaclia.com/*",
        "https://www.pisos.com/*"
      ],
      "js": ["portal-links.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.bcousinoprop.com/es/admin/extension*",
        "https://portal.bcousinoprop.com/cl/admin/extension*"
      ],
      "js": ["crm-connect.js"],
      "run_at": "document_idle"
    }
  ]
}
