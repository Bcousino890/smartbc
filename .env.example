NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública del portal donde se sirven los SmartLinks (/compartir, /c) y
# los assets generados (/og, /p). Se usa para construir URLs absolutas en
# metadatos Open Graph para WhatsApp/Twitter — debe ser el dominio público
# REAL, sin auth básica. En producción: https://portal.bcousinoprop.com.
NEXT_PUBLIC_PORTAL_URL=https://portal.bcousinoprop.com

# Token requerido por el endpoint /api/cron/sync (Fase 4 sindicación).
# Vercel Cron envía la cabecera x-vercel-cron automáticamente, pero para
# disparos manuales o externos usar `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=change-me-to-a-long-random-string

# Fase 5 · scraper de Level Real Estate.
# Cuántas propiedades procesar como máximo por sync. Por defecto 25 (cubre
# 5-10 min con rate limit 2.5s/req). Para el primer sync completo de las
# ~319 propiedades, ejecutar el scraper localmente con LEVEL_SYNC_LIMIT=999.
LEVEL_SYNC_LIMIT=25

# Filtro de zonas (opcional). CSV de palabras clave (sin acentos, lowercase).
# Si está activo, el scraper solo importa propiedades cuya ubicación contenga
# alguna keyword. Match parcial: "salamanca" caza "Barrio de Salamanca".
# Dejar vacío para no filtrar y traer todo el catálogo.
LEVEL_ALLOWED_ZONES=salamanca,chamberi,retiro,pozuelo

# Proxy residencial Smartproxy para scraping de Idealista/Fotocasa.
# Formato: http://usuario:contraseña@host:puerto
# Si está configurado, se usa como fallback cuando recibe 403/429.
# Obtén las credenciales exactas de tu dashboard Smartproxy:
# Dashboard → Residential Proxy → Configuración de proxy
# IMPORTANTE: este fichero es el TEMPLATE público — nunca pegues
# credenciales reales aquí. Ponlas únicamente en `.env.local` (que está
# gitignored).
SMARTPROXY_URL=http://user:password@eu.smartproxy.net:3120

# ── Evomi "expert settings" (OPCIONAL, apagado por defecto) ──────────────────
# Filtran el pool residencial de Evomi para dar IPs más "limpias", lo que puede
# reducir el bloqueo duro (t=bv) de DataDome en el endpoint de teléfono de
# Idealista. ⚠️ CADA filtro MULTIPLICA el consumo de ancho de banda (coste):
# actívalos solo si el pool está muy baneado y estás dispuesto a pagar más GB.
# Doc: docs.evomi.com/proxy-instructions/residential-proxies/expert-settings
#   EVOMI_FRAUDSCORE     = puntuación Scamalytics MÁXIMA (0-100; menor = IP más
#                          limpia). Sugerido 10-25. Vacío = desactivado.
#   EVOMI_MIN_UPTIME_MIN = minutos mínimos que la IP lleva conectada (más
#                          estable). Vacío = desactivado.
# EVOMI_FRAUDSCORE=20
# EVOMI_MIN_UPTIME_MIN=120

# Secreto para firmar los enlaces de autopublicación en Idealista (extensión
# de Chrome). Si se deja vacío, cae a CRON_SECRET. Cambiar en producción.
IDEALISTA_EXT_SECRET=change-me-to-a-long-random-string

# ============================================================
# AWS SES Configuration for Password Reset & Notifications
# ============================================================
# Fallback: si email_config table en BD está vacía, se usan estas variables.
# Para producción, configura estos valores en `.env.local` o usa el panel admin.
# eu-west-3 (no eu-west-1): es la región donde la cuenta tiene identidades
# verificadas y "Acceso a producción concedido" en SES. La verificación y el
# estado sandbox/producción son POR REGIÓN — apuntar a otra región distinta a
# la verificada da "Email address is not verified" aunque el remitente exista.
AWS_SES_REGION=eu-west-3
AWS_SES_ACCESS_KEY_ID=your-ses-access-key-id
AWS_SES_SECRET_ACCESS_KEY=your-ses-secret-access-key
FROM_EMAIL=noreply@bcousinoprop.com
FROM_NAME=SmartBC
EMAIL_ENCRYPTION_KEY=your-encryption-key-for-password-storage

# ============================================================
# Admin Email Addresses - Auto-promotion on Login
# ============================================================
# Lista de emails que se promoverán automáticamente a rol "admin"
# al primer login si no tienen perfil. Separa múltiples emails con comas.
# Ejemplo: benjamincousino1@gmail.com,admin@portal.bcousinoprop.com
# Si está vacío, los nuevos usuarios se crean con rol "client"
ADMIN_EMAILS=benjamincousino1@gmail.com

# ============================================================
# Logo.dev Integration (Institution Logos in Marquee)
# ============================================================
# Logo.dev publishable key for fetching institution logos
NEXT_PUBLIC_LOGO_DEV_KEY=pk_fxtQX2tuQi6nhbAQY3jUKQ

# ============================================================
# Zinto WhatsApp Integration
# ============================================================
# API key from Zinto dashboard: https://crm.zinto.app/settings
ZINTO_API_KEY=your-zinto-api-key
# Zinto API base URL (default: https://crm.zinto.app/api/v1)
ZINTO_BASE_URL=https://crm.zinto.app/api/v1
# Webhook secret (HMAC SHA256) for verifying Zinto's native delivery-status
# webhooks (message.sent / delivered / failed).
ZINTO_WEBHOOK_SECRET=your-webhook-secret
# Shared token for authenticating INBOUND message webhooks sent by a Zinto Flow
# ("Disparador de Mensaje" -> "Webhook" node). Add it in the flow's Custom
# Headers as:  X-Zinto-Token: <this value>
ZINTO_INBOUND_TOKEN=your-inbound-token
# WhatsApp channel IDs from Zinto (GET /channels). On the SmartBC instance:
#   4 = WhatsApp ESPAÑA, 50 = WhatsApp CHILE, 51 = Web (webchat).
# ZINTO_CHANNEL_ID is the default; the per-country ones are used by /admin.
ZINTO_CHANNEL_ID=4
ZINTO_CHANNEL_ID_ES=4
ZINTO_CHANNEL_ID_CL=50
# NOTE: In production these values live ENCRYPTED in the zinto_config table
# (managed from /admin/configuracion), which takes precedence over these env
# vars. Leave placeholders here; never commit real keys.

# ============================================================
# Zinto Integration API (contrato nuevo — CRM)
# ============================================================
# Distinto del bloque anterior: ese es el cliente legacy de envío de WhatsApp
# + leads/sync. Este es el cliente nuevo (lib/services/zinto-integration/**)
# contra el contrato de docs/api/SMARTBC-INTEGRATION-GUIDE-2026-08-13.md.
#
# ⚠️ ESTAS VARIABLES SON UN RESPALDO, NO LA FUENTE DE VERDAD.
# Desde 2026-09-13 la credencial y la URL salen de la tabla `zinto_config`
# (Configuración → WhatsApp (Zinto)), y la BD gana sobre el entorno — ver
# lib/services/zinto-integration/server-config.ts. Tener la clave en dos
# sitios fue justo lo que dejó la integración muerta cuatro semanas sin que
# nadie lo notara: el panel probaba una credencial y la app usaba otra.
# Estas variables sólo actúan si la tabla está vacía, y en los scripts CLI.
#
# Base SIN sufijo: el cliente compone las rutas completas (/api/v1/...) él
# solo. Si pones aquí ".../api/v1" se normaliza — pero si algún día alguien
# se salta esa normalización, la petición sale como /api/v1/api/v1/... y el
# 404 parece que Zinto haya retirado el endpoint.
#
# ⚠️ El valor viejo era https://crm.zinto.app/_integration-api. Ese prefijo
# DEJÓ DE EXISTIR: hoy devuelve el HTML de la web de Zinto con un 200 para
# cualquier ruta, incluidas /health y un /me sin autenticar.
ZINTO_API_URL=https://crm.zinto.app
# Clave exclusiva de SmartBC, asociada a la empresa bcousinoprop, con los
# scopes del piloto (ver docs/api/SMARTBC-ONBOARDING-2026-08-13.md). Formato:
# pcp_<64 caracteres hexadecimales>. NUNCA usar el scope "*" fuera de pruebas
# administrativas puntuales.
ZINTO_API_KEY=pcp_your-64-hex-char-key
# Secreto whsec_... devuelto UNA SOLA VEZ al registrar el webhook con
# POST /api/v1/webhooks (scope webhooks:manage). Firma HMAC-SHA256 de
# "<timestamp>.<raw_body>", cabecera X-Zinto-Signature: v1=<hex>.
# Lo normal es NO ponerlo aquí: el botón "Registrar webhook" del panel lo
# guarda cifrado en zinto_config.integration_webhook_secret_encrypted.
ZINTO_WEBHOOK_SECRET=whsec_your-webhook-secret
# Flag de activación: en false, el cliente y el receptor
# app/api/webhooks/zinto-integration/route.ts responden como no disponibles
# sin tocar el comportamiento legacy. Actívalo solo tras confirmar con Zinto
# que bcousinoprop está en la allowlist de escritura del piloto.
ZINTO_INTEGRATION_API_ENABLED=false
# Confirmación explícita (fuera de este repo, por soporte de Zinto) de que la
# API key/empresa bcousinoprop está en la allowlist operativa de escritura.
# Tener scopes de escritura NO basta: sin esto, Zinto puede devolver 403
# aunque la clave tenga contacts:write/messages:send/etc. No lo pongas en
# true hasta tener esa confirmación por escrito.
ZINTO_WRITE_ALLOWLISTED=false
#
# Leads / campaigns / sync (same API key + base URL; the key needs the
# campaigns/leads/sync scopes enabled). Lead events (lead.*) are delivered to
# the same webhook endpoint /api/webhooks/zinto and verified with the HMAC
# signature (ZINTO_WEBHOOK_SECRET).
