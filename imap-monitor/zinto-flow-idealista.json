{
  "exportDate": "2026-06-07T14:00:00.000Z",
  "version": "1.0",
  "flows": [
    {
      "name": "Leads Idealista → CRM",
      "description": "Recibe leads del monitor IMAP. Crea contacto con notas y responde al lead en su idioma (ES/EN) automáticamente.",
      "status": "active",
      "nodes": [
        {
          "id": "node_wh",
          "data": {
            "label": "Nuevo Lead de Idealista",
            "webhookToken": "a3f037ba3ab44a7b880cc644cc21fb8a",
            "useCustomPath": false,
            "contactMapping": { "strategy": "system" },
            "responseConfig": {
              "mode": "async",
              "headers": {},
              "statusCode": 200,
              "bodyTemplate": "{\"success\": true}"
            },
            "sourcePosition": "bottom",
            "targetPosition": "top",
            "filterConditions": []
          },
          "type": "webhookTrigger",
          "width": 280,
          "height": 152,
          "position": { "x": 340, "y": 60 },
          "positionAbsolute": { "x": 340, "y": 60 }
        },
        {
          "id": "node_contact",
          "data": {
            "label": "Crear Contacto Lead",
            "operation": "create_contact",
            "showAdvanced": true,
            "updateFields": {
              "name": "{{webhook.contact_name}}",
              "phone": "{{webhook.contact_phone}}",
              "notes": "{{webhook.contact_notes}}",
              "tags": ["Idealista", "{{webhook.property_type}}", "{{webhook.property_price}}"]
            },
            "errorHandling": "continue",
            "sourcePosition": "bottom",
            "targetPosition": "top",
            "skipEmptyValues": true,
            "contactIdVariable": "{{contact.id}}",
            "deleteConfirmation": false
          },
          "type": "manage_contact",
          "width": 380,
          "height": 200,
          "position": { "x": 300, "y": 280 },
          "positionAbsolute": { "x": 300, "y": 280 }
        },
        {
          "id": "node_lang_detect",
          "data": {
            "label": "Detectar Idioma del Mensaje",
            "code": "// Detecta si el mensaje del lead está en inglés o en otro idioma\nconst msg = `{{webhook.lead_message}}`;\n\nconst englishWords = /\\b(hello|hi|good\\s(morning|afternoon|evening)|interested|available|apartment|flat|property|could\\s(you|i)|would\\s(like|be)|please|thank\\s(you|s)|dear|sir|madam|we\\s(are|would)|I\\s(am|would)|looking\\s(for|to))\\b/i;\nconst spanishChars  = /[áéíóúüñ¡¿]|\\b(hola|gracias|buenos|buenas|estoy|tengo|quisiera|quiero|disponible|saber|interesado|inmueble|pareja|médico|colombiano|sería|podría|además|también|aparte|muchas|necesitas|presenta|nominas)\\b/i;\n\nconst looksEnglish  = englishWords.test(msg);\nconst looksSpanish  = spanishChars.test(msg);\n\n// Si tiene indicadores de inglés Y no tiene de español → inglés\nconst lang = (looksEnglish && !looksSpanish) ? 'en' : 'es';\n\nreturn { lang };",
            "timeout": 5000,
            "sourcePosition": "bottom",
            "targetPosition": "top"
          },
          "type": "code_execution",
          "width": 380,
          "height": 200,
          "position": { "x": 300, "y": 550 },
          "positionAbsolute": { "x": 300, "y": 550 }
        },
        {
          "id": "node_cond_lang",
          "data": {
            "label": "¿Mensaje en inglés?",
            "condition": "{{code_execution.lang}} == 'en'",
            "sourcePosition": "bottom",
            "targetPosition": "top"
          },
          "type": "condition",
          "width": 360,
          "height": 120,
          "position": { "x": 300, "y": 820 },
          "positionAbsolute": { "x": 300, "y": 820 }
        },
        {
          "id": "node_msg_en",
          "data": {
            "label": "WhatsApp → Lead (English)",
            "phoneNumber": "{{webhook.contact_phone}}",
            "messageContent": "Hi {{webhook.contact_name}}, how are you? 👋\n\nYou reached out about the property at *{{webhook.property_address}}* ({{webhook.property_type}}). Tell me, what day would you like to visit? Can I call you on the phone?\n\nBest regards! 😊",
            "sourcePosition": "bottom",
            "targetPosition": "top",
            "channelConnectionId": null
          },
          "type": "contactNotification",
          "width": 380,
          "height": 240,
          "position": { "x": 700, "y": 1020 },
          "positionAbsolute": { "x": 700, "y": 1020 }
        },
        {
          "id": "node_msg_es",
          "data": {
            "label": "WhatsApp → Lead (Español)",
            "phoneNumber": "{{webhook.contact_phone}}",
            "messageContent": "Hola {{webhook.contact_name}} qué tal? Nos consultaste por el piso *{{webhook.property_address}}* en {{webhook.property_type}}, cuéntame qué día te gustaría visitarlo, ¿te puedo llamar por teléfono?\n\n¡Un saludo! 😊",
            "sourcePosition": "bottom",
            "targetPosition": "top",
            "channelConnectionId": null
          },
          "type": "contactNotification",
          "width": 380,
          "height": 240,
          "position": { "x": -100, "y": 1020 },
          "positionAbsolute": { "x": -100, "y": 1020 }
        }
      ],
      "edges": [
        {
          "id": "e1",
          "type": "smoothstep",
          "source": "node_wh",
          "target": "node_contact",
          "animated": true,
          "targetHandle": "flow-in"
        },
        {
          "id": "e2",
          "type": "smoothstep",
          "source": "node_contact",
          "target": "node_lang_detect",
          "animated": true,
          "targetHandle": "flow-in"
        },
        {
          "id": "e3",
          "type": "smoothstep",
          "source": "node_lang_detect",
          "target": "node_cond_lang",
          "animated": true,
          "targetHandle": "flow-in"
        },
        {
          "id": "e4_true",
          "type": "smoothstep",
          "source": "node_cond_lang",
          "target": "node_msg_en",
          "animated": true,
          "sourceHandle": "condition-true",
          "targetHandle": "flow-in"
        },
        {
          "id": "e5_false",
          "type": "smoothstep",
          "source": "node_cond_lang",
          "target": "node_msg_es",
          "animated": true,
          "sourceHandle": "condition-false",
          "targetHandle": "flow-in"
        }
      ],
      "version": 1,
      "createdAt": "2026-06-07T14:00:00.000Z",
      "updatedAt": "2026-06-07T14:00:00.000Z"
    }
  ]
}
