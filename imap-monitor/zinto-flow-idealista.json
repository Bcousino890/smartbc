            "contactMapping": {
              "strategy": "system"
            },
            "responseConfig": {
              "mode": "async",
              "headers": {},
              "statusCode": 200,
              "bodyTemplate": "{\"success\": true, \"message\": \"Lead recibido\"}"
            },
            "sourcePosition": "bottom",
            "targetPosition": "top",
            "filterConditions": []
          },
          "type": "webhookTrigger",
          "width": 280,
          "height": 152,
          "position": { "x": 320, "y": 100 },
          "positionAbsolute": { "x": 320, "y": 100 }
        },
        {
          "id": "node_idealista_create_contact",
          "data": {
            "label": "Crear Contacto Lead",
            "operation": "create_contact",
            "showAdvanced": true,
            "updateFields": {
