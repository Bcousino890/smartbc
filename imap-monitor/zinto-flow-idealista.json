{
  "exportDate": "2026-06-07T14:00:00.000Z",
  "version": "1.0",
  "flows": [
    {
      "name": "Leads Idealista → CRM",
      "description": "Recibe leads del monitor IMAP de Idealista. Crea el contacto con notas y le envía un WhatsApp automático de bienvenida.",
      "status": "active",
      "nodes": [
        {
          "id": "node_idealista_webhook_trigger",
          "data": {
            "label": "Nuevo Lead de Idealista",
            "webhookToken": "a3f037ba3ab44a7b880cc644cc21fb8a",
            "useCustomPath": false,
            "contactMapping": {
              "strategy": "system"
            },
            "responseConfig": {
              "mode": "async",
              "headers": {},
              "statusCode": 200,
              "bodyTemplate": "{\"success\": true, \"message\": \"Lead recibido\"}"
            },
            "sourcePosition": "bottom",
            "targetPosition": "top",
            "filterConditions": []
          },
          "type": "webhookTrigger",
          "width": 280,
          "height": 152,
          "position": { "x": 320, "y": 80 },
          "positionAbsolute": { "x": 320, "y": 80 }
        },
        {
          "id": "node_idealista_create_contact",
          "data": {
            "label": "Crear Contacto Lead",
            "operation": "create_contact",
            "showAdvanced": true,
            "updateFields": {
              "name": "{{webhook.contact_name}}",
              "phone": "{{webhook.contact_phone}}",
              "notes": "{{webhook.contact_notes}}"
            },
            "errorHandling": "continue",
            "sourcePosition": "bottom",
            "targetPosition": "top",
            "skipEmptyValues": true,
            "contactIdVariable": "{{contact.id}}",
            "deleteConfirmation": false
          },
          "type": "manage_contact",
          "width": 380,
          "height": 200,
          "position": { "x": 260, "y": 300 },
          "positionAbsolute": { "x": 260, "y": 300 }
        },
        {
          "id": "node_idealista_whatsapp_lead",
          "data": {
            "label": "WhatsApp al Lead",
            "phoneNumber": "{{webhook.contact_phone}}",
            "messageContent": "¡Hola {{webhook.contact_name}}! 👋\n\nGracias por tu interés en el inmueble *{{webhook.property_address}}* (Ref. {{webhook.property_ref}}).\n\nSoy Andrea de *BCousino Properties*. He visto tu mensaje y me encantaría ayudarte. ¿Cuándo te viene bien hablar para contarte más detalles y organizar una visita?\n\n¡Un saludo! 😊",
            "sourcePosition": "bottom",
            "targetPosition": "top",
            "channelConnectionId": null
          },
          "type": "contactNotification",
          "width": 380,
          "height": 240,
          "position": { "x": 260, "y": 570 },
          "positionAbsolute": { "x": 260, "y": 570 }
        }
      ],
      "edges": [
        {
          "id": "edge_trigger_to_contact",
          "type": "smoothstep",
          "source": "node_idealista_webhook_trigger",
          "target": "node_idealista_create_contact",
          "animated": true,
          "targetHandle": "flow-in"
        },
        {
          "id": "edge_contact_to_whatsapp",
          "type": "smoothstep",
          "source": "node_idealista_create_contact",
          "target": "node_idealista_whatsapp_lead",
          "animated": true,
          "targetHandle": "flow-in"
        }
      ],
      "version": 1,
      "createdAt": "2026-06-07T14:00:00.000Z",
      "updatedAt": "2026-06-07T14:00:00.000Z"
    }
  ]
